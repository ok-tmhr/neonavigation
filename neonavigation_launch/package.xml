  <version>0.1.0</version>
  <description>Demonstration and sample launch files for neonavigation meta-package</description>

  <maintainer email="tomohiro.oku2023@gmail.com">Tomohiro Oku</maintainer>
  <license>BSD</license>
  <author email="atsushi.w@ieee.org">Atsushi Watanabe</author>
  <author email="tomohiro.oku2023@gmail.com">Tomohiro Oku</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>costmap_cspace</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>planner_cspace</exec_depend>
  <exec_depend>safety_limiter</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>trajectory_tracker</exec_depend>
