<?xml version="1.0"?>
<launch>
  <arg name="dev" default="/dev/input/js1"/>
  <arg name="cmd_vel_out" />
  <arg name="cmd_vel_in" />
  <arg name="linear_vel" />
  <arg name="angular_vel" />

  <node pkg="joy" exec="joy_node" name="joystick" >
    <param name="dev" value="$(var dev)" />
    <remap from="/joy" to="/joystick_interrupt/joy" />
  </node>

  <node pkg="joystick_interrupt" exec="joystick_interrupt" name="joystick_interrupt">
    <param name="interrupt_button" value="6" />
    <param name="high_speed_button" value="-1" />
    <param name="linear_axis" value="1" />
    <param name="angular_axis" value="0" />
    <param name="linear_axis2" value="10" />
    <param name="angular_axis2" value="9" />
    <param name="linear_vel" value="$(var linear_vel)" />
    <param name="angular_vel" value="$(var angular_vel)" />
    <param name="linear_high_speed_ratio" value="1.3" />
    <param name="angular_high_speed_ratio" value="1.1" />
    <remap from="~/cmd_vel" to="$(var cmd_vel_out)" />
    <remap from="~/cmd_vel_input" to="$(var cmd_vel_in)" />
    <remap from="/joy" to="/joystick_interrupt/joy" />
  </node>
</launch>
