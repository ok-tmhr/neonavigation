<?xml version="1.0"?>
<launch>
  <set_env name="GCOV_PREFIX" value="/tmp/gcov/dynamic_parameter_change" />

  <node name="test_dynamic_parameter_change" pkg="planner_cspace" exec="test_dynamic_parameter_change" time-limit="90.0" />

  <node pkg="costmap_cspace" exec="costmap_3d" name="costmap_3d">
    <param name="footprint" value="'[[0.01, -0.01], [0.01, 0.01], [-0.01, 0.01], [-0.01, -0.01]]'" />
    <param name="ang_resolution" value="16"/>
    <param name="linear_expand" value="0.0"/>
    <param name="linear_spread" value="0.3"/>
  </node>
  <node pkg="planner_cspace" exec="planner_3d" name="planner_3d">
    <remap from="move_base_simple/goal" to="/goal" />
  </node>
  <node pkg="nav2_map_server" exec="map_server" name="map_server_global" args="$(find planner_cspace)/test/data/global_map.yaml" />
  <node pkg="tf2_ros" exec="static_transform_publisher" name="stf1"
        args="0 0 0 0 0 0 map odom" />

</launch>
