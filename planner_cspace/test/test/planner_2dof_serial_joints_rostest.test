<?xml version="1.0"?>
<launch>
  <node pkg="planner_cspace" exec="planner_2dof_serial_joints" name="planner_2dof_serial_joints" output="screen">
    <param name="group_names" value="[group0]" />
    <param name="replan_interval" value="1.0" />

    <param name="group0">
      <param name="link0_name" value="front" />
      <param name="link1_name" value="rear" />
      <param name="resolution" value="128" />
      <param name="weight_cost" value="4.0" />
      <param name="expand" value="0.15" />

      <param name="link0_joint_radius" value="0.5" />
      <param name="link1_joint_radius" value="0.5" />
      <param name="link0_end_radius" value="0.5" />
      <param name="link1_end_radius" value="0.5" />
      <param name="link0_x" value="1.0" />
      <param name="link1_x" value="-1.0" />
      <param name="link0_y" value="0.0" />
      <param name="link1_y" value="0.0" />
      <param name="link0_th" value="0.0" />
      <param name="link1_th" value="0.0" />
      <param name="link0_gain_th" value="-1.0" />
      <param name="link1_gain_th" value="1.0" />
      <param name="link0_length" value="1.0" />
      <param name="link1_length" value="1.0" />
    </param>
  </node>
</launch>
