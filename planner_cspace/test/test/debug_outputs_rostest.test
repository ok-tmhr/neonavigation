<?xml version="1.0"?>
<launch>
  <set_env name="GCOV_PREFIX" value="/tmp/gcov/planner_cspace_debug_outputs" />

  <node pkg="costmap_cspace" exec="costmap_3d" name="costmap_3d">
    <param name="footprint" value="'[[0.2, -0.1], [0.2, 0.1], [-0.2, 0.1], [-0.2, -0.1]]'" />

    <param name="ang_resolution" value="16"/>
    <param name="linear_expand" value="0.1"/>
    <param name="linear_spread" value="0.0"/>
    <param name="static_layers" value="[unknown]" />
    <param name="unknown" >
      <param name="type" value="Costmap3dLayerUnknownHandle" />
      <param name="unknown_cost" value="100" />
    </param>
    <param name="layers" value="[overlay]" />
    <param name="overlay">
      <param name="type" value="Costmap3dLayerFootprint" />
      <param name="overlay_mode" value="max" />
    </param>
  </node>
  <node pkg="planner_cspace" exec="planner_3d" name="planner_3d" output="screen">
    <remap from="move_base_simple/goal" to="goal" />
    <param name="remember_updates" value="true" />
    <param name="remember_hit_prob" value="0.99" />
    <param name="remember_hit_miss" value="0.01" />
    <param name="hist_ignore_range" value="0.0" />
    <param name="hist_ignore_range_max" value="1.0" />
    <param name="pos_jump" value="100.0" />
    <param name="yaw_jump" value="100.0" />
  </node>

  <node pkg="nav2_map_server" exec="map_server" name="map_server_global">
    <param name="yaml_filename" value="$(find-pkg-share planner_cspace)/test/data/global_map.yaml" />
  </node>
  <node pkg="costmap_cspace" exec="largemap_to_map" name="largemap_to_map">
    <remap from="map_local" to="overlay" />
    <param name="width" value="15" />
    <param name="hz" value="5.0" />
  </node>

  <node pkg="rostopic" exec="rostopic" name="pub_goal"
    args="pub -l /goal geometry_msgs/PoseStamped -f $(find-pkg-share planner_cspace)/test/data/goal_debug_outputs.yaml" />

  <node pkg="tf2_ros" exec="static_transform_publisher" name="stf1"
      args="0 0 0 0 0 0 map odom" />
  <node pkg="tf2_ros" exec="static_transform_publisher" name="stf2"
      args="2.5 0.5 0 3.14 0 0 odom base_link" />

  <node name="test_debug_outputs" pkg="planner_cspace" exec="test_debug_outputs" output="screen" />

  <timer period="15.0">
    <shutdown />
  </timer>

  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager">
    <param name="node_names" value="[map_server_global]" />
    <param name="autostart" value="true" />
  </node>

</launch>
