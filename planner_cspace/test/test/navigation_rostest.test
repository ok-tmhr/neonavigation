<?xml version="1.0"?>
<launch>
  <arg name="antialias_start" default="false" />
  <arg name="fast_map_update" default="false" />
  <arg name="with_tolerance" default="false" />
  <arg name="enable_crowd_mode" default="false" />
  <set_env name="GCOV_PREFIX" value="/tmp/gcov/planner_cspace_navigation_$(var antialias_start)_$(var fast_map_update)_$(var with_tolerance)_$(var enable_crowd_mode)" />

  <!-- TODO time-limit="260.0" -->
  <executable name="test_navigate_$(var antialias_start)_$(var fast_map_update)_$(var with_tolerance)_$(var enable_crowd_mode)" cmd="./build/planner_cspace/test/test_navigate --ros-args -p enable_crowd_mode:=$(var enable_crowd_mode)" output="screen">
  </executable>

  <node pkg="costmap_cspace" exec="costmap_3d" name="costmap_3d">
    <param name="footprint" value="'[[0.2, -0.1], [0.2, 0.1], [-0.2, 0.1], [-0.2, -0.1]]'" />
    <param name="ang_resolution" value="16"/>
    <param name="linear_expand" value="0.1"/>
    <param name="linear_spread" value="0.1"/>
    <param name="static_layers" value="[unknown, overlay]" />
    <param name="unknown">
      <param name="type" value="Costmap3dLayerUnknownHandle" />
      <param name="unknown_cost" value="100" />
    </param>
    <param name="overlay">
      <param name="type" value="Costmap3dLayerFootprint" />
      <param name="overlay_mode" value="max" />
    </param>
  </node>
  <node pkg="planner_cspace" exec="planner_3d" name="planner_3d" output="screen">
    <remap from="move_base_simple/goal" to="goal" />
    <param name="max_vel" value="0.1" />
    <param name="max_ang_vel" value="0.3" />
    <param name="goal_tolerance_lin" value="0.025" />
    <param name="antialias_start" value="$(var antialias_start)" />
    <param name="fast_map_update" value="$(var fast_map_update)" />
    <param name="enable_crowd_mode" value="$(var enable_crowd_mode)" />
    <param name="temporary_escape" value="$(var enable_crowd_mode)" />
    <param name="retain_last_error_status" value="false" />
  </node>
  <node pkg="trajectory_tracker" exec="trajectory_tracker" name="spur">
    <param name="max_vel" value="0.1" />
    <param name="max_acc" value="0.4" />
    <param name="max_angvel" value="0.3" />
    <param name="max_angacc" value="1.0" />

    <param name="curv_forward" value="0.1" />
    <param name="look_forward" value="0.0" />
    <param name="k_dist" value="5.5" />
    <param name="k_ang" value="3.0" />
    <param name="k_avel" value="4.0" />

    <param name="path_step" value="1" />

    <param name="limit_vel_by_avel" value="true" />

    <param name="hz" value="30.0" />
    <param name="dist_lim" value="0.5" />

    <param name="rotate_ang" value="0.2" />

    <param name="goal_tolerance_dist" value="0.025" />
    <param name="goal_tolerance_ang" value="0.025" />
    <param name="stop_tolerance_dist" value="0.02" />
    <param name="stop_tolerance_ang" value="0.02" />
    <param name="no_position_control_dist" value="0.01" />
  </node>

  <node pkg="nav2_map_server" exec="map_server" name="map_server_global" >
    <remap from="map" to="map_global" />
    <param name="yaml_filename" value="$(find-pkg-share planner_cspace)/test/data/global_map.yaml" />
  </node>
  <node pkg="nav2_map_server" exec="map_server" name="map_server_local" >
    <remap from="map" to="map_local" />
    <param name="yaml_filename" value="$(find-pkg-share planner_cspace)/test/data/local_map.yaml" />
  </node>

  <node pkg="planner_cspace" exec="patrol" name="patrol">
    <param name="with_tolerance" value="$(var with_tolerance)" />
    <param name="tolerance_lin" value="0.1" />
    <param name="tolerance_ang" value="0.1" />
  </node>

  <node pkg="planner_cspace" exec="dummy_robot" name="dummy_robot">
    <param name="initial_x" value="2.5" />
    <param name="initial_y" value="0.45" />
    <param name="initial_yaw" value="3.14" />
  </node>
  <node pkg="tf2_ros" exec="static_transform_publisher" name="stf1"
      args="0 0 0 0 0 0 map odom" />

  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" >
    <param name="autostart" value="true" />
    <param name="node_names" value="[map_server_global, map_server_local]" />
  </node>
</launch>
