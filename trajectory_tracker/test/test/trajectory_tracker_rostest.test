<?xml version="1.0"?>
<launch>
  <arg name="odom_delay" default="0.0" />
  <arg name="use_odom" default="false" />
  <arg name="use_time_optimal_control" default="true" />

  <set_env name="GCOV_PREFIX" value="/tmp/gcov/trajectory_tracker_d$(var odom_delay)_$(var use_odom)_$(var use_time_optimal_control)" />

  <set_parameter name="use_sim_time" value="true" /><!-- clock is provided by the test node -->

  <node name="test_trajectory_tracker" pkg="trajectory_tracker" exec="test_trajectory_tracker" output="screen" if="$(var use_odom)">
    <param name="odom_delay" value="$(var odom_delay)" />
  </node>

  <node name="test_trajectory_tracker" pkg="trajectory_tracker" exec="test_trajectory_tracker" output="screen" unless="$(var use_odom)">
    <param name="odom_delay" value="$(var odom_delay)" />
    <param name="error_lin" value="0.03" />
    <param name="error_ang" value="0.02" />
  </node>

  <timer period="120.0">
    <shutdown />
  </timer>

  <node pkg="trajectory_tracker" exec="trajectory_tracker" name="trajectory_tracker" output="screen">
    <param name="max_vel" value="1.0" />
    <param name="max_acc" value="2.0" />
    <param name="max_angvel" value="0.5" />
    <param name="max_angacc" value="2.0" />
    <param name="goal_tolerance_dist" value="0.005" />
    <param name="goal_tolerance_ang" value="0.005" />
    <param name="stop_tolerance_dist" value="0.002" />
    <param name="stop_tolerance_ang" value="0.002" />
    <param name="look_forward" value="0.0" />
    <param name="k_dist" value="4.5" />
    <param name="k_ang" value="3.0" />
    <param name="k_avel" value="4.0" />
    <param name="gain_at_vel" value="1.0" />
    <param name="dist_lim" value="0.5" />
    <param name="use_odom" value="$(var use_odom)" />
    <param name="odom_timeout_sec" value="0.0" />
    <param name="use_time_optimal_control" value="$(var use_time_optimal_control)" />
    <param name="k_ang_rotation" value="8.0" />
    <param name="k_avel_rotation" value="5.0" />
  </node>
</launch>
